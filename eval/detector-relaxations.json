      "falsePositiveCaseId": "gp-029-adjacent-redaction-statements-remain-safe",
      "mustBlockCaseId": "sb-026-unverified-secret-target-blocks",
      "sharedTrigger": "redact",
      "rationale": "Separate removed statements must not be combined into a secret guard, while an actual removed header-redaction guard must remain blocked without matching coverage."
